@incollection{langeWhereverMayRoam2024a,
  title = {Wherever {{I May Roam}}: {{Stealthy Interception}} and {{Injection Attacks Through Roaming Agreements}}},
  shorttitle = {Wherever {{I May Roam}}},
  booktitle = {Computer {{Security}} -- {{ESORICS}} 2024},
  author = {Lange, Swantje and Gringoli, Francesco and Hollick, Matthias and Classen, Jiska},
  editor = {{Garcia-Alfaro}, Joaquin and Kozik, Rafa{\l} and Chora{\'s}, Micha{\l} and Katsikas, Sokratis},
  year = {2024},
  volume = {14985},
  pages = {208--228},
  publisher = {Springer Nature Switzerland},
  address = {Cham},
  doi = {10.1007/978-3-031-70903-6_11},
  urldate = {2025-05-26},
  abstract = {Cellular network users can be attacked through Rogue Base Stations (RBSes). 3G introduced network authentication as a mitigation. However, roaming partnerships between network operators allow requesting authentication vectors. This feature opens doors for state-sponsored attackers with access to roaming infrastructure, allowing the operation of stealthy RBSes anywhere in the world. This by far exceeds what lawful interception interfaces were designed for but provides attackers with similar capabilities, such as network traffic interception, manipulation, and injecting management frames towards a user's device. Updated 5G roaming procedures do not prevent this issue. We demonstrate that modern smartphones effectively cannot indicate such attacks to end-users.},
  isbn = {978-3-031-70902-9 978-3-031-70903-6},
  langid = {english},
  file = {/Users/adijuliawan/Library/CloudStorage/GoogleDrive-adijuliawanpawana@unud.ac.id/My Drive/Zotero/[01] PhD/[02] Publication/[202505] IDS Roaming Cloud/Lange et al. - 2024 - Wherever I May Roam Stealthy Interception and Injection Attacks Through Roaming Agreements.pdf}
}

